# ANTIGRAVITY AI - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp ".env" olarak kaydedin ve değerleri girin.
# DİKKAT: Gerçek ".env" dosyasını ASLA git reposuna eklemeyin!

# BINANCE API AYARLARI
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true
PAPER_TRADING=true

# TELEGRAM BİLDİRİMLERİ
# @BotFather üzerinden alınan bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# @userinfobot veya @get_id_bot üzerinden alınan kullanıcı/kanal chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
