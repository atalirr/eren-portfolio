              </tr>
            `).join('')}
          </tbody>
        </table>

        <table class="totals">
          <tr>
            <td>Ara Toplam:</td>
            <td class="right">${formatCurrency(invoice.subtotal)}</td>
          </tr>
          ${invoice.total_discount > 0 ? `
            <tr style="color: #EA580C;">
              <td>İskonto:</td>
              <td class="right">-${formatCurrency(invoice.total_discount)}</td>
