# Backend environment variables (example)
#
# Copy this file to `.env` inside the `backend/` folder and set values.
# `start.ps1` starts the backend from `backend/`, so `.env` will be loaded.
#
# n8n webhook URL for invoice image parsing (Gemini workflow)
# Example:
# N8N_FATURA_OKUR_URL=https://your-n8n-domain.com/webhook/fatura-okur
N8N_FATURA_OKUR_URL=

# Optional: n8n test webhook URL (requires "Listen for test event")
# Example:
# N8N_FATURA_OKUR_TEST_URL=http://localhost:5678/webhook-test/fatura-okur
N8N_FATURA_OKUR_TEST_URL=

