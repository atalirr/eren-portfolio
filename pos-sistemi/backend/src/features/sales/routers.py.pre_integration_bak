@router.get("/sales/refund-stats")
async def get_refund_stats(
    days: int = Query(30, ge=1, le=365, description="Son kaç gün"),
    db: Session = Depends(get_db)
):
    """İade oranı ve istatistikleri (kasa sayfası kartı için)"""
    try:
        cutoff = datetime.utcnow() - timedelta(days=days)

        completed = db.query(
            func.count(SaleOrder.id).label("cnt"),
            func.sum(SaleOrder.total_amount).label("total"),
        ).filter(
            SaleOrder.status == OrderStatus.COMPLETED,
            SaleOrder.is_deleted == False,
            SaleOrder.created_at >= cutoff,
        ).first()

        refunded = db.query(
            func.count(SaleOrder.id).label("cnt"),
            func.sum(SaleOrder.total_amount).label("total"),
        ).filter(
            SaleOrder.status == OrderStatus.REFUNDED,
            SaleOrder.created_at >= cutoff,
        ).first()

        completed_count = int(completed.cnt or 0)
        refunded_count  = int(refunded.cnt or 0)
        total_count     = completed_count + refunded_count

        return {
            "total_sales":       total_count,
            "completed_sales":   completed_count,
            "refunded_sales":    refunded_count,
            "refund_rate":       round((refunded_count / total_count * 100), 2) if total_count > 0 else 0.0,
            "completed_amount":  float(completed.total or 0),
            "refunded_amount":   float(refunded.total or 0),
            "period_days":       days,
        }
    except Exception as e:
        import traceback
        print(f"[ERROR] Refund stats hatasi: {str(e)}")
        print(traceback.format_exc())
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"İade istatistikleri alınamadı: {str(e)}"
        )


