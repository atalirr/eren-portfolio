"""
Sales Routers
Satış Modülü - FastAPI Routes
"""

from typing import List
from datetime import datetime, timedelta
from fastapi import APIRouter, Depends, HTTPException, status, Query
from sqlalchemy.orm import Session
from sqlalchemy import func

from src.shared.database.session import get_db
from src.features.sales import schemas
from src.features.sales.models import SaleOrder, SaleOrderItem, OrderStatus
from src.features.sales.services import SalesService
from src.features.inventory.models import Product


router = APIRouter()


@router.post("/sales", response_model=schemas.OrderResponse, status_code=status.HTTP_201_CREATED)
async def create_sale(
    order_data: schemas.OrderCreateSchema,
    user_id: str = Query(default="default-user-id", description="Kullanıcı ID"),  # TODO: Gerçek uygulamada JWT token'dan alınmalı
    db: Session = Depends(get_db)
):
    """
    Yeni satış oluştur
    
    Atomik transaction içinde:
    - Stok ve maliyet kontrolü
    - Sipariş kaydı (total_profit hesaplama ile)
    - Stok düşümü
    - Finansal yansıma (Transaction veya Customer balance)
    """
    try:
        service = SalesService(db)
        sale_order = service.process_sale(order_data, user_id)
        
        # Response için items'ı da ekle
        sale_order_dict = {
            "id": sale_order.id,
            "order_number": sale_order.order_number,
            "customer_id": sale_order.customer_id,
            "total_amount": sale_order.total_amount,
            "total_profit": sale_order.total_profit,
            "payment_method": sale_order.payment_method.value,
            "platform": sale_order.platform.value,
            "status": sale_order.status.value,
            "created_at": sale_order.created_at.isoformat(),
            "discount_type": sale_order.discount_type,
            "discount_value": sale_order.discount_value,
            "discount_amount": sale_order.discount_amount,
            "final_amount": sale_order.final_amount,
            "items": [
                {
                    "id": item.id,
                    "order_id": item.order_id,
                    "product_id": item.product_id,
                    "product_name": item.product_name,
                    "quantity": item.quantity,
                    "unit_price": item.unit_price,
                    "unit_cost": item.unit_cost,
                    "discount": item.discount or 0.0,
                }
                for item in sale_order.items
            ]
        }
        
        return sale_order_dict
        
    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(e)
        )
    except Exception as e:
        import traceback
        print(f"[ERROR] Satis islemi hatasi: {str(e)}")
        print(traceback.format_exc())
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Satış işlemi sırasında hata oluştu: {str(e)}"
        )


