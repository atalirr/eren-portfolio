@router.get("/sales/analysis/products/{product_id}/weekly")
async def get_product_weekly_sales(
    product_id: str,
    db: Session = Depends(get_db)
):
    """
    Ürün haftalık satış analizi (son 7 gün)
    Stok kartı arka yüzü için günlük satış grafik verileri
    """
    try:
        today = datetime.utcnow().date()
        seven_days_ago = today - timedelta(days=6)

        results = (
            db.query(
                func.date(SaleOrder.created_at).label("sale_date"),
                func.sum(SaleOrderItem.quantity).label("total_qty"),
                func.sum(SaleOrderItem.quantity * SaleOrderItem.unit_price).label("total_revenue"),
            )
            .join(SaleOrderItem, SaleOrder.id == SaleOrderItem.order_id)
            .filter(
                SaleOrderItem.product_id == product_id,
                SaleOrder.is_deleted == False,
                SaleOrder.status == OrderStatus.COMPLETED,
                func.date(SaleOrder.created_at) >= str(seven_days_ago),
            )
            .group_by(func.date(SaleOrder.created_at))
            .all()
        )

        results_by_date = {str(r.sale_date): r for r in results}

        day_labels = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz']
        days = []
        total_qty = 0
        total_revenue = 0.0

        for i in range(7):
            d = seven_days_ago + timedelta(days=i)
            date_str = str(d)
            day_label = day_labels[d.weekday()]

            if date_str in results_by_date:
                r = results_by_date[date_str]
                qty = int(r.total_qty or 0)
                revenue = float(r.total_revenue or 0)
            else:
                qty = 0
                revenue = 0.0

            total_qty += qty
            total_revenue += revenue
            days.append({"date": date_str, "label": day_label, "qty": qty, "revenue": revenue})

        return {"product_id": product_id, "days": days, "total_qty": total_qty, "total_revenue": total_revenue}

    except Exception as e:
        import traceback
        print(f"[ERROR] Urun haftalik satis hatasi: {str(e)}")
        print(traceback.format_exc())
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Haftalık satış verisi alınamadı: {str(e)}"
        )

