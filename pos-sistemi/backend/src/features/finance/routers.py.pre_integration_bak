@router.get("/advanced-projection", response_model=schemas.AdvancedProjectionResponse)
async def get_advanced_projection(
    target_month: Optional[int] = Query(None, ge=1, le=12, description="Hedef ay (1-12). None ise mevcut ay."),
    target_year: Optional[int] = Query(None, description="Hedef yıl. None ise mevcut yıl."),
    db: Session = Depends(get_db)
):
    """
    Gelişmiş Trend ve Projeksiyon Analizi
    
    **Pace (Hız) Analizi:**
    - Bugünün şu anki saati (örn: 14:30) ile geçen ayın aynı günlerinin (tüm Salı günleri) saat 14:30'daki kümülatif cirosunu kıyaslar
    - Çıktı: "Bugün düne göre yavaş başladı (%-10)" veya "Geçen haftaya göre %15 daha hızlı gidiyoruz."
    
    **Ay Sonu Tahmini (Run Rate Prediction):**
    - Ayın tamamlanmış günlerinin ortalamasını alarak değil, "Ağırlıklı Ortalama" (Son günler daha önemli) kullanarak ayın geri kalanı için tahmini ciro hesaplar
    - Formül: `(Mevcut Ciro) + (Kalan Gün Sayısı * Son 7 Günlük Hareketli Ortalama)`
    
    **Mevsimsellik (Seasonality):**
    - Hafta sonu çarpanını hesaba katarak tahmini düzeltir
    """
    service = FinanceService(db)
    data = service.get_advanced_projection(
        target_month=target_month,
        target_year=target_year
    )
    return data


