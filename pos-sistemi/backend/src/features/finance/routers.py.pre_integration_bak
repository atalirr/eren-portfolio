@router.get("/payment-methods-distribution")
async def get_payment_methods_distribution(
    scope: str = Query('general', description="'local' veya 'general'"),
    start_date: Optional[str] = Query(None, description="Başlangıç tarihi (ISO format: YYYY-MM-DDTHH:MM:SS) - Bu tarihten sonraki verileri getirir"),
    db: Session = Depends(get_db)
):
    """
    Ödeme Yöntemleri Dağılımı
    
    - scope='local': Sadece satış sayfasından gelen ödeme yöntemleri (POS/LOCAL)
    - scope='general': Tüm kaynaklar (E-ticaret + Satış + Manuel gelirler)
    - start_date: Bu tarihten sonraki verileri getirir (sıfırlama zamanı için)
    
    NOT: Şu anda bu endpoint'te hata oluşsa bile 500 dönmek yerine
    boş bir liste döndürerek frontend'i kırmıyoruz.
    """
    try:
        service = FinanceService(db)
        data = service.get_payment_methods_distribution(scope=scope, start_date=start_date)
        return {"payment_methods_distribution": data}
    except Exception as e:
        import traceback
        error_trace = traceback.format_exc()
        print(f"[ERROR] Payment methods distribution hatası: {e}")
        print(f"[ERROR] Traceback: {error_trace}")
        # Hata durumunda bile 200 dön ve boş liste ver
        return {"payment_methods_distribution": []}


