@router.get("/kdv-report")
async def get_kdv_report(
    days: int = Query(30, ge=1, le=365, description="Son N gun"),
    db: Session = Depends(get_db)
):
    """
    KDV Raporu - Toplanan ve Odenen KDV ozeti
    Parasut KDV Raporu benzeri
    """
    from sqlalchemy import func
    from src.features.sales.models import SaleOrder, SaleOrderItem, OrderStatus as SaleOrderStatus
    from src.features.invoices.models import Invoice, InvoiceItem, InvoiceType

    try:
        cutoff = datetime.utcnow() - __import__('datetime').timedelta(days=days)

        # Satis faturalari uzerinden toplanan KDV (İndirim düşülmüş matrah, iadeler hariç - Issue C2)
        collected_vat = {}
        try:
            net_line_expr = SaleOrderItem.unit_price * SaleOrderItem.quantity - func.coalesce(SaleOrderItem.discount, 0.0)
            sale_items = db.query(
                SaleOrderItem.tax_rate,
                func.sum(net_line_expr).label("base"),
            ).join(SaleOrder, SaleOrder.id == SaleOrderItem.order_id).filter(
                SaleOrder.is_deleted == False,
                SaleOrder.status == SaleOrderStatus.COMPLETED,
                SaleOrder.created_at >= cutoff
            ).group_by(SaleOrderItem.tax_rate).all()

            for rate, base in sale_items:
                r_val = float(rate or 18)
                b = float(base or 0)
                vat = b * (r_val / (100 + r_val))  # KDV dahil fiyattan KDV'yi cikart
                rate_key = str(int(r_val)) if r_val == int(r_val) else str(r_val)
                collected_vat[rate_key] = round(vat, 2)
        except Exception:
            pass

        # Alis faturalari uzerinden odenen KDV
        paid_vat = {}
        try:
            purchase_items = db.query(
                InvoiceItem.vat_rate,
                func.sum(InvoiceItem.vat_amount).label("vat_total"),
            ).join(Invoice, Invoice.id == InvoiceItem.invoice_id).filter(
                Invoice.is_deleted == False,
                Invoice.invoice_type == InvoiceType.PURCHASE,
                Invoice.created_at >= cutoff
            ).group_by(InvoiceItem.vat_rate).all()

            for rate, vat_total in purchase_items:
                r_val = float(rate or 20)
                rate_key = str(int(r_val)) if r_val == int(r_val) else str(r_val)
                paid_vat[rate_key] = round(float(vat_total or 0), 2)
        except Exception:
            pass

        total_collected = sum(collected_vat.values())
        total_paid = sum(paid_vat.values())
        net_vat = total_collected - total_paid

        return {
            "period_days": days,
            "collected_vat": collected_vat,
            "paid_vat": paid_vat,
            "total_collected": round(total_collected, 2),
            "total_paid": round(total_paid, 2),
            "net_vat_payable": round(net_vat, 2),
            "summary": "Odenecek KDV" if net_vat > 0 else "Devreden KDV",
        }
    except Exception as e:
        return {"error": str(e), "total_collected": 0, "total_paid": 0, "net_vat_payable": 0}


@router.get("/cash-flow-projection")
async def get_cash_flow_projection(
    months: int = Query(3, ge=1, le=12, description="Kac aylik projeksiyon"),
    db: Session = Depends(get_db)
):
    """
    Nakit Akisi Projeksiyonu - Parasut Nakit Akisi Raporu benzeri
    Gecmis verilerden gelecek projeksiyon
    """
    from sqlalchemy import func
    from src.features.transactions.models import Transaction, TransactionType
    from src.features.customers.models import Customer
    from src.features.suppliers.models import Supplier

    try:
        now = datetime.utcnow()
        thirty_days_ago = now - __import__('datetime').timedelta(days=30)

        # Son 30 gun gelir ortalamalari
        monthly_income = 0.0
        try:
            result = db.query(func.coalesce(func.sum(Transaction.amount), 0.0)).filter(
                Transaction.type == TransactionType.INCOME,
                Transaction.is_deleted == False,
                Transaction.created_at >= thirty_days_ago
            ).scalar()
            monthly_income = float(result or 0)
        except Exception:
            pass

        # Son 30 gun gider ortalamalari
        monthly_expense = 0.0
        try:
            result = db.query(func.coalesce(func.sum(Transaction.amount), 0.0)).filter(
                Transaction.type == TransactionType.EXPENSE,
                Transaction.is_deleted == False,
                Transaction.created_at >= thirty_days_ago
            ).scalar()
            monthly_expense = float(result or 0)
        except Exception:
            pass

        # Mevcut kasa bakiyesi
        current_cash = 0.0
        try:
            inc = db.query(func.coalesce(func.sum(Transaction.amount), 0.0)).filter(
                Transaction.type == TransactionType.INCOME, Transaction.is_deleted == False, Transaction.payment_source == "CASH"
            ).scalar() or 0
            exp = db.query(func.coalesce(func.sum(Transaction.amount), 0.0)).filter(
                Transaction.type == TransactionType.EXPENSE, Transaction.is_deleted == False, Transaction.payment_source == "CASH"
            ).scalar() or 0
            current_cash = float(inc) - float(exp)
        except Exception:
            pass

        # Beklenen alacaklar (musteri borclari)
        receivables = 0.0
        try:
            result = db.query(func.coalesce(func.sum(Customer.balance), 0.0)).filter(
                Customer.is_deleted == False, Customer.balance > 0
            ).scalar()
            receivables = float(result or 0)
        except Exception:
            pass

        # Beklenen borclar (tedarikci borclari)
        payables = 0.0
        try:
            result = db.query(func.coalesce(func.sum(Supplier.balance), 0.0)).filter(
                Supplier.is_deleted == False, Supplier.balance > 0
            ).scalar()
            payables = float(result or 0)
        except Exception:
            pass

        # Aylik projeksiyon
        net_monthly = monthly_income - monthly_expense
        projection = []
        running_balance = current_cash
        for i in range(1, months + 1):
            running_balance += net_monthly
            month_date = now + __import__('datetime').timedelta(days=30 * i)
            projection.append({
                "month": month_date.strftime("%Y-%m"),
                "month_label": month_date.strftime("%B %Y"),
                "projected_income": round(monthly_income, 2),
                "projected_expense": round(monthly_expense, 2),
                "projected_balance": round(running_balance, 2),
            })

        return {
            "current_cash": round(current_cash, 2),
            "monthly_income_avg": round(monthly_income, 2),
            "monthly_expense_avg": round(monthly_expense, 2),
            "net_monthly": round(net_monthly, 2),
            "receivables": round(receivables, 2),
            "payables": round(payables, 2),
            "projection": projection,
        }
    except Exception as e:
        return {"error": str(e), "current_cash": 0, "projection": []}
