    Dashboard için finansal verileri getir
    
    - Gelir Kaynakları (Donut Chart): Perakende, E-Ticaret, Kurumsal/Diğer
    - Kâr ve Ciro Makası (Area Chart): Günlük ciro, maliyet, giderler, net kâr
    - Gider Analizi (Top 5 Liste): Kategori bazında giderler
    """
    service = FinanceService(db)
    
    # Tarih dönüşümü
    start_dt = None
    end_dt = None
    
    if start_date:
        try:
            start_dt = datetime.strptime(start_date, "%Y-%m-%d")
        except ValueError:
            start_dt = None
    
    if end_date:
        try:
            end_dt = datetime.strptime(end_date, "%Y-%m-%d")
        except ValueError:
            end_dt = None
    
    data = service.get_finance_dashboard_data(
        start_date=start_dt,
        end_date=end_dt,
        days=days
    )
    
    return data


