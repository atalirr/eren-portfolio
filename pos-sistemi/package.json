{
  "name": "atli-medikal-pos",
  "version": "1.0.0",
  "description": "ATLI Medikal POS Sistemi - Modern Point of Sale Uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "pos",
    "electron",
    "medikal",
    "stok",
    "satış",
    "türkçe"
  ],
  "author": "ATLI Medikal",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sqlite3": "^5.1.7",
    "chart.js": "^4.5.0"
  },
  "build": {
    "appId": "com.atlimedikal.pos",
    "productName": "ATLI Medikal POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!*.log"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
